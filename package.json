{
  "name": "teleport-beams",
  "displayName": "Teleport Beams",
  "description": "Manage and connect to Teleport Beams from VS Code",
  "version": "0.1.0",
  "publisher": "teleport",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cassiebreviu/beam-vs-code"
  },
  "icon": "resources/beam-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:beamClusters", "onView:beamsList", "onView:beamFiles", "onView:beamActivity", "onView:beamEvents", "onView:beamSessionProfiles", "onCommand:beams.connect", "onFileSystem:beam-git"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "teleport-beams",
          "title": "Beams",
          "icon": "resources/beam-icon.svg"
        }
      ]
    },
    "views": {
      "teleport-beams": [
        {
          "id": "beamClusters",
          "name": "Clusters"
        },
        {
          "id": "beamsList",
          "name": "Beams"
        },
        {
          "id": "beamFiles",
          "name": "Files"
        },
        {
          "id": "beamActivity",
          "name": "Agent Activity"
        },
        {
          "id": "beamEvents",
          "name": "Agent Events"
        },
        {
          "id": "beamSessionProfiles",
          "name": "Session Profiles"
        }
      ]
    },
    "commands": [
      { "command": "beams.select", "title": "Select Beam", "category": "Beams" },
      { "command": "beams.refresh", "title": "Refresh", "icon": "$(refresh)", "category": "Beams" },
      { "command": "beams.create", "title": "Create Beam", "icon": "$(add)", "category": "Beams" },
      { "command": "beams.delete", "title": "Delete Beam", "icon": "$(trash)", "category": "Beams" },
      { "command": "beams.ssh", "title": "SSH into Beam", "icon": "$(terminal)", "category": "Beams" },
      { "command": "beams.openFiles", "title": "Open Beam Files", "icon": "$(folder-opened)", "category": "Beams" },
      { "command": "beams.publish", "title": "Publish Beam", "icon": "$(globe)", "category": "Beams" },
      { "command": "beams.unpublish", "title": "Unpublish Beam", "category": "Beams" },
      { "command": "beams.copyUrl", "title": "Copy URL", "category": "Beams" },
      { "command": "beams.connect", "title": "Open in VS Code (Remote-SSH)", "icon": "$(remote)", "category": "Beams" },
      { "command": "beams.openFile", "title": "Open File", "category": "Beams" },
      { "command": "beams.refreshFiles", "title": "Refresh Files", "icon": "$(refresh)", "category": "Beams" },
      { "command": "beams.export", "title": "Export as Zip", "icon": "$(cloud-download)", "category": "Beams" },
      { "command": "beams.saveAsTemplate", "title": "Save as Template", "icon": "$(save)", "category": "Beams" },
      { "command": "beams.deleteTemplate", "title": "Delete Custom Template", "category": "Beams" },
      { "command": "beams.login", "title": "Login", "icon": "$(key)", "category": "Beams" },
      { "command": "beams.setupGithub", "title": "Setup GitHub on Beam", "icon": "$(mark-github)", "category": "Beams" },
      { "command": "beams.run", "title": "Run on Beam", "icon": "$(play)", "category": "Beams" },
      { "command": "beams.showActivityDetail", "title": "Show Detail", "category": "Beams" },
      { "command": "beams.showDiff", "title": "Show Diff", "icon": "$(diff)", "category": "Beams" },
      { "command": "beams.gitStage", "title": "Stage File", "icon": "$(add)", "category": "Beams" },
      { "command": "beams.gitUnstage", "title": "Unstage File", "icon": "$(remove)", "category": "Beams" },
      { "command": "beams.gitCommit", "title": "Commit", "icon": "$(check)", "category": "Beams" },
      { "command": "beams.gitDiscard", "title": "Discard Changes", "icon": "$(discard)", "category": "Beams" },
      { "command": "beams.gitRefreshScm", "title": "Refresh Git Status", "icon": "$(refresh)", "category": "Beams" },
      { "command": "beams.selectScm", "title": "Initialize SCM", "category": "Beams" },
      { "command": "beams.saveSessionProfile", "title": "Save Session Profile", "icon": "$(save)", "category": "Beams" },
      { "command": "beams.resumeSessionProfile", "title": "Resume Session Profile", "icon": "$(play-circle)", "category": "Beams" },
      { "command": "beams.viewSessionProfile", "title": "View Session Profile", "category": "Beams" },
      { "command": "beams.deleteSessionProfile", "title": "Delete Session Profile", "icon": "$(trash)", "category": "Beams" },
      { "command": "beams.refreshSessionProfiles", "title": "Refresh Session Profiles", "icon": "$(refresh)", "category": "Beams" }
    ],
    "menus": {
      "view/title": [
        { "command": "beams.login", "when": "view == beamsList", "group": "navigation" },
        { "command": "beams.refresh", "when": "view == beamsList", "group": "navigation" },
        { "command": "beams.create", "when": "view == beamsList", "group": "navigation" },
        { "command": "beams.refreshFiles", "when": "view == beamFiles", "group": "navigation" },
        { "command": "beams.resumeSessionProfile", "when": "view == beamSessionProfiles", "group": "navigation" },
        { "command": "beams.refreshSessionProfiles", "when": "view == beamSessionProfiles", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "beams.connect", "when": "view == beamsList", "group": "inline" },
        { "command": "beams.run", "when": "view == beamsList", "group": "inline" },
        { "command": "beams.ssh", "when": "view == beamsList", "group": "inline" },
        { "command": "beams.openFiles", "when": "view == beamsList", "group": "1_connect" },
        { "command": "beams.publish", "when": "view == beamsList && viewItem == beam", "group": "2_actions" },
        { "command": "beams.unpublish", "when": "view == beamsList && viewItem == beamPublished", "group": "2_actions" },
        { "command": "beams.copyUrl", "when": "view == beamsList && viewItem == beamPublished", "group": "2_actions" },
        { "command": "beams.export", "when": "view == beamsList", "group": "2_actions" },
        { "command": "beams.setupGithub", "when": "view == beamsList", "group": "2_actions" },
        { "command": "beams.saveAsTemplate", "when": "view == beamsList", "group": "2_actions" },
        { "command": "beams.saveSessionProfile", "when": "view == beamsList", "group": "2_actions" },
        { "command": "beams.delete", "when": "view == beamsList", "group": "3_danger" },
        { "command": "beams.showDiff", "when": "view == beamFiles && viewItem == beamFile", "group": "inline" },
        { "command": "beams.resumeSessionProfile", "when": "view == beamSessionProfiles && viewItem == sessionProfile", "group": "inline" },
        { "command": "beams.deleteSessionProfile", "when": "view == beamSessionProfiles && viewItem == sessionProfile", "group": "3_danger" }
      ],
      "scm/title": [
        { "command": "beams.gitCommit", "when": "scmProvider == beam-git", "group": "navigation" },
        { "command": "beams.gitRefreshScm", "when": "scmProvider == beam-git", "group": "navigation" }
      ],
      "scm/resourceState/context": [
        { "command": "beams.gitStage", "when": "scmProvider == beam-git && scmResourceGroup == changes", "group": "inline" },
        { "command": "beams.gitStage", "when": "scmProvider == beam-git && scmResourceGroup == untracked", "group": "inline" },
        { "command": "beams.gitUnstage", "when": "scmProvider == beam-git && scmResourceGroup == staged", "group": "inline" },
        { "command": "beams.gitDiscard", "when": "scmProvider == beam-git && scmResourceGroup == changes", "group": "1_modification" }
      ]
    },
    "configuration": {
      "title": "Beams",
      "properties": {
        "beams.github.username": {
          "type": "string",
          "default": "",
          "description": "GitHub username for automatic credential setup on new beams"
        },
        "beams.github.email": {
          "type": "string",
          "default": "",
          "description": "Git commit email for new beams (defaults to username@users.noreply.github.com)"
        },
        "beams.github.authMethod": {
          "type": "string",
          "enum": ["", "pat", "oauth", "tsh-git"],
          "default": "",
          "description": "Preferred GitHub auth method. Empty means ask every time."
        },
        "beams.github.autoSetup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically configure GitHub on new beams using stored preferences"
        },
        "beams.github.defaultCloneRepo": {
          "type": "string",
          "default": "",
          "description": "Repository to clone automatically on new beams (owner/repo format)"
        },
        "beams.git.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Git/SCM integration for beams with git repositories"
        },
        "beams.git.statusPollInterval": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 60,
          "description": "Interval (seconds) for polling git status on the beam"
        },
        "beams.git.fileStatPollInterval": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 30,
          "description": "Interval (seconds) for polling open file changes on the beam"
        }
      }
    }
  },
  "scripts": {
    "dev": "tsc -watch -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "npm run compile",
    "package": "vsce package --no-dependencies",
    "install-local": "code --install-extension teleport-beams-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
